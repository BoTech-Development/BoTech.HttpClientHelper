<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>BoTech.HttpClientHelper</Title>
    <Company>www.BoTech.dev</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>1.0.7</AssemblyVersion>
    <FileVersion>1.0.7</FileVersion>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Description>An http client wrapper (with json encoding), to make http request to api easier</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>1.0.7-Alpha</Version>
    <PackageProjectUrl>https://docs.botech.dev/botech-httpclienthelper/v1-1/about/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BoTech-Development/BoTech.HttpClientHelper</RepositoryUrl>
    <PackageTags>Http Client ApiClient</PackageTags>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	<PackageIcon>BoTechLogoSmall.drawio.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\BoTechLogoSmall.drawio.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>BoTechLogoSmall.drawio.png</Link>
    </None>
    <None Include="..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
